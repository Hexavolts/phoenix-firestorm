<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater
 border="true"
 can_close="true"
 can_minimize="true"
 can_resize="false"
 save_rect="true"
 height="330"
 width="490"
 name="fs_inventory_autofile_floater"
 title="Inventory Auto-File Rules">
  <text
   name="autofile_intro_txt"
   type="string"
   follows="left|top"
   height="32"
   layout="topleft"
   left="10"
   top="10"
   width="470"
   wrap="true">
   Items given to you by objects or received via group notices will be automatically moved into the listed folder when their name matches the regex pattern. Rules are checked in order; the first match wins. Folders are created automatically when a rule is saved.
  </text>
  <scroll_list
   top_pad="10"
   left="10"
   height="130"
   width="470"
   follows="left|top"
   column_padding="0"
   draw_heading="true"
   multi_select="false"
   name="autofile_rules_list"
   search_column="1">
    <scroll_list.columns
        label="Regex Pattern"
        name="pattern"
        relative_width="0.45" />
    <scroll_list.columns
        label="Destination Folder"
        name="folder"
        relative_width="0.55" />
  </scroll_list>
  <button
   top_pad="10"
   left="10"
   height="22"
   width="90"
   enabled="true"
   follows="left|top"
   mouse_opaque="true"
   halign="center"
   scale_image="true"
   name="autofile_add_entry"
   label="Add..."/>
  <button
   top_delta="0"
   left_pad="10"
   height="22"
   width="90"
   enabled="false"
   follows="left|top"
   mouse_opaque="true"
   halign="center"
   scale_image="true"
   name="autofile_delete_entry"
   label="Remove"/>
  <view_border
   top_pad="14"
   left="2"
   height="0"
   width="486"
   follows="left|top"
   bevel_style="none"
   border_thickness="1"
   mouse_opaque="false"
   name="divisor1"/>
  <text
   name="autofile_pattern_txt"
   type="string"
   follows="left|top"
   height="16"
   layout="topleft"
   left="10"
   top_pad="13"
   width="80">
   Pattern:
  </text>
  <line_editor
   name="autofile_pattern"
   follows="left|top"
   height="23"
   layout="topleft"
   left="100"
   max_length_bytes="255"
   top_delta="-5"
   width="200"
   enabled="false"
   />
  <text
   name="autofile_folder_txt"
   type="string"
   follows="left|top"
   height="16"
   layout="topleft"
   left="10"
   top_pad="10"
   width="80">
   Folder:
  </text>
  <line_editor
   name="autofile_folder"
   follows="left|top"
   height="23"
   layout="topleft"
   left="100"
   max_length_bytes="255"
   top_delta="-5"
   width="200"
   enabled="false"
   />
  <button
   top_delta="0"
   right="-10"
   height="22"
   width="90"
   enabled="false"
   follows="left|top"
   mouse_opaque="true"
   halign="center"
   scale_image="true"
   name="autofile_save_entry"
   label="Save Entry"
   tool_tip="Save this rule."/>
  <view_border
   top_pad="14"
   left="2"
   height="0"
   width="486"
   follows="left|top"
   bevel_style="none"
   border_thickness="1"
   mouse_opaque="false"
   name="divisor2"/>
  <button
   top_pad="10"
   right="380"
   height="22"
   width="90"
   enabled="true"
   follows="left|top"
   mouse_opaque="true"
   halign="center"
   scale_image="true"
   name="autofile_save_changes"
   label="Save Changes"
   tool_tip="Save all changes."/>
  <button
   top_delta="0"
   right="480"
   height="22"
   width="90"
   enabled="true"
   follows="left|top"
   mouse_opaque="true"
   halign="center"
   scale_image="true"
   name="autofile_cancel"
   label="Cancel"
   tool_tip="Discard all changes."/>
</floater>
