<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<panel
  follows="all"
  height="576"
  layout="topleft"
  name="panel_login"
  focus_root="true"
  background_visible="false"
  width="1024">
  <panel.string
    name="forgot_password_url">
    http://secondlife.com/account/request.php
  </panel.string>
  <string name="ServerComboTooltip">
    An existing grid or a grid URI
  </string>

  <!-- Custom background image, fills the whole panel and stretches with the window -->
  <icon
    follows="all"
    left="0"
    top="0"
    width="1024"
    height="576"
    image_name="login_lilystorm_bg"
    name="login_background" />

  <!-- Outer vertical split: everything above the footer, then the footer itself (fixed height,
       always flush against the bottom no matter how tall the actual window is, since layout_stack
       recalculates this on every resize instead of relying on fixed-pixel offsets). -->
  <layout_stack
    follows="all"
    orientation="vertical"
    left="0"
    top="0"
    width="1024"
    height="576"
    name="root_vstack">

    <layout_panel
      auto_resize="true"
      name="content_area">

      <!-- Horizontal split: left side is empty (lets the character art show through),
           right side holds the login fields, always hugging the right edge. -->
      <layout_stack
        follows="all"
        orientation="horizontal"
        left="0"
        top="0"
        width="1024"
        height="526"
        name="content_hstack">

        <layout_panel
          auto_resize="true"
          name="left_spacer" />

        <layout_panel
          auto_resize="false"
          width="380"
          height="526"
          name="right_fields_area">

          <!-- Vertical split within the fields column: spacer / fields block / spacer,
               so the fields block is always vertically centered regardless of window height. -->
          <layout_stack
            follows="all"
            orientation="vertical"
            left="0"
            top="0"
            width="380"
            height="526"
            name="fields_vstack">

            <layout_panel
              auto_resize="true"
              name="fields_spacer_top" />

            <layout_panel
              auto_resize="false"
              height="260"
              name="fields_block">

              <panel
                follows="left|top"
                left="20"
                top="0"
                width="340"
                height="72"
                background_visible="false"
                name="login">
                <text
                  follows="left|top"
                  font="SansSerifLarge"
                  text_color="White"
                  height="18"
                  left="0"
                  top="0"
                  name="username_label"
                  width="300">
                  Username
                </text>
                <combo_box
                  left="0"
                  top_pad="6"
                  allow_text_entry="true"
                  follows="left|top|right"
                  height="34"
                  label="Username"
                  combo_editor.font="SansSerifLarge"
                  max_chars="128"
                  force_disable_fulltext_search="true"
                  combo_editor.commit_on_focus_lost="false"
                  combo_editor.prevalidator="ascii"
                  tool_tip="The username you chose when you registered, like bobsmith12 or Steller Sunshine"
                  name="username_combo"
                  width="300">
                  <combo_box.combo_editor
                    text_pad_left="14"
                    text_pad_right="14"
                    bg_image_always_focused="true"
                    background_image="login_btn_normal"
                    background_image_disabled="login_btn_normal"
                    background_image_focused="login_btn_normal"
                    text_color="White"/>
                </combo_box>
              </panel>

              <text
                follows="left|top"
                font="SansSerifLarge"
                text_color="White"
                height="18"
                left="20"
                top_pad="16"
                name="password_label"
                width="300">
                Password
              </text>
              <!-- The max length might be changed in FSPanelLogin.cpp for Opensim! -->
              <line_editor
                follows="left|top|right"
                height="34"
                left="20"
                top_pad="6"
                max_length_chars="16"
                text_pad_left="14"
                text_pad_right="14"
                name="password_edit"
                label="Password"
                bg_image_always_focused="true"
                background_image="login_btn_normal"
                background_image_disabled="login_btn_normal"
                background_image_focused="login_btn_normal"
                text_color="White"
                font="SansSerifLarge"
                is_password="true"
                select_on_focus="true"
                commit_on_focus_lost="false"
                width="300" />

              <button
                follows="left|top"
                image_unselected="login_btn_normal"
                image_selected="login_btn_normal"
                image_pressed="login_btn_normal"
                image_hover_unselected="login_btn_hover"
                image_hover_selected="login_btn_hover"
                label="Log In"
                label_color="White"
                font="SansSerifLarge"
                name="connect_btn"
                width="150"
                height="40"
                left="20"
                top_pad="18"/>

            </layout_panel>

            <layout_panel
              auto_resize="true"
              name="fields_spacer_bottom" />

          </layout_stack>
        </layout_panel>

      </layout_stack>
    </layout_panel>

    <!-- Footer: remember checkboxes, location/grid/mode, account links. Fixed height,
         always flush against the true bottom of the window. -->
    <layout_panel
      auto_resize="false"
      height="46"
      background_visible="true"
      bg_opaque_color="Black"
      background_opaque="true"
      name="login_footer">

      <layout_stack
        follows="all"
        orientation="horizontal"
        left="10"
        top="4"
        height="40"
        width="1004"
        name="footer_stack">

        <layout_panel
          auto_resize="false"
          width="32"
          height="40"
          name="delete_container">
          <button
            follows="top"
            height="32"
            top="3"
            image_unselected="TrashItem_Off"
            image_selected="TrashItem_Press"
            image_pressed="TrashItem_Press"
            tool_tip="Remove this username"
            label=""
            left="0"
            name="remove_user_btn"
            width="32" />
        </layout_panel>

        <layout_panel
          auto_resize="false"
          width="160"
          height="40"
          name="remember_username_panel">
          <check_box
            tab_stop="false"
            control_name="FSRememberUsername"
            follows="left|top"
            font="SansSerifSmall"
            left="5"
            top="12"
            height="16"
            label="Remember username"
            name="remember_username_check"
            width="150" />
        </layout_panel>

        <layout_panel
          auto_resize="false"
          width="160"
          height="40"
          name="remember_password_panel">
          <check_box
            tab_stop="false"
            control_name="RememberPassword"
            enabled_control="FSRememberUsername"
            follows="left|top"
            font="SansSerifSmall"
            left="0"
            top="12"
            height="16"
            label="Remember password"
            name="remember_check"
            width="150" />
        </layout_panel>

        <layout_panel
          auto_resize="false"
          width="180"
          height="40"
          name="start_location_panel">
          <combo_box
            allow_text_entry="true"
            control_name="NextLoginLocation"
            follows="left|top"
            label="Start location"
            height="28"
            top="6"
            max_chars="128"
            combo_editor.font="SansSerifSmall"
            left="0"
            name="start_location_combo"
            width="170"
            combo_button.scale_image="true">
            <combo_box.combo_editor
              bg_image_always_focused="true"
              text_pad_left="8"
              text_pad_right="8"/>
            <combo_box.item
              label="Last location"
              name="MyLastLocation"
              value="last" />
            <combo_box.item
              label="Home"
              name="MyHome"
              value="home" />
            <combo_box.item
              label="&lt;Type region name&gt;"
              name="Typeregionname" value="" />
          </combo_box>
        </layout_panel>

        <layout_panel
          auto_resize="true"
          width="20"
          height="40"
          name="footer_spacer_1" />

        <layout_panel
          auto_resize="false"
          visible="false"
          width="0"
          height="40"
          name="grid_panel">
          <text
            follows="left|top"
            font="SansSerifSmall"
            height="16"
            name="grid_login_text"
            valign="center"
            top="14"
            left="0"
            width="35">
            Grid:
          </text>
          <combo_box
            allow_text_entry="true"
            font="SansSerifSmall"
            follows="left|top"
            height="28"
            top="6"
            max_chars="256"
            combo_editor.font="SansSerifSmall"
            left_pad="5"
            force_disable_fulltext_search="true"
            combo_editor.commit_on_focus_lost="false"
            combo_editor.prevalidator="ascii"
            name="server_combo"
            width="170"
            combo_button.scale_image="true" >
            <combo_box.drop_down_button
              font="SansSerifSmall"/>
          </combo_box>
          <text
            follows="left|top"
            font="SansSerifMedium"
            text_color="EmphasisColor"
            top_pad="2"
            height="14"
            name="grid_builder_text"
            valign="center"
            left="40"
            width="250"
            visible="false">
          + Click to add more grids
          </text>
        </layout_panel>

        <layout_panel
          auto_resize="false"
          visible="false"
          width="0"
          height="40"
          name="mode_selection">
          <text
            follows="left|top"
            font="SansSerifSmall"
            valign="center"
            height="16"
            name="mode_selection_text"
            top="14"
            left="0"
            width="45">
            Mode:
          </text>
          <combo_box
            follows="left|top"
            top="6"
            left_pad="5"
            height="28"
            max_chars="128"
            tool_tip="Select which style of viewer you are most familiar with to set your defaults to appropriately."
            name="mode_combo"
            width="120"
            combo_button.scale_image="true">
            <combo_box.drop_down_button
              font="SansSerifSmall"/>
            <combo_box.item
              label="Firestorm"
              name="Firestorm"
              value="settings_firestorm.xml" />
            <combo_box.item
              label="Phoenix"
              name="Phoenix"
              value="settings_phoenix.xml" />
            <combo_box.item
              label="Modern"
              name="Modern"
              value="settings_modern.xml" />
            <combo_box.item
              label="[VIEWER_GENERATION]"
              name="V3"
              value="settings_v3.xml" />
            <combo_box.item
              label="Hybrid"
              name="Hybrid"
              value="settings_hybrid.xml" />
            <combo_box.item
              label="Text"
              name="Text"
              value="settings_text.xml" />
          </combo_box>
        </layout_panel>

        <layout_panel
          auto_resize="true"
          width="20"
          height="40"
          name="footer_spacer_2" />

        <layout_panel
          auto_resize="false"
          width="140"
          height="40"
          name="create_account_panel">
          <text
            follows="left|top"
            font="SansSerifMedium"
            text_color="0.45 0.38 0.65 1"
            height="16"
            left="0"
            top="14"
            name="create_new_account_text"
            width="140">
            Create an account
          </text>
        </layout_panel>

        <layout_panel
          auto_resize="false"
          width="120"
          height="40"
          name="forgot_password_panel">
          <text
            follows="left|top"
            font="SansSerifMedium"
            text_color="0.45 0.38 0.65 1"
            height="16"
            left="0"
            top="14"
            name="forgot_password_text"
            width="120">
            Forgot password?
          </text>
        </layout_panel>

      </layout_stack>
    </layout_panel>

  </layout_stack>
</panel>
